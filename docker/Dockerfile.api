FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .

ENV MODEL_PATH=/app/artifacts/model.joblib \
    PIPELINE_PATH=/app/artifacts/model.pipeline.joblib

EXPOSE 8000

CMD ["uvicorn", "log_analyzer.inference.api:app", "--host", "0.0.0.0", "--port", "8000"]
